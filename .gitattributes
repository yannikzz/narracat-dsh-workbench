# Normalize line endings in text; keep binary assets untouched.
* text=auto eol=lf

*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.svg text eol=lf
*.css text eol=lf

*.png binary
*.webp binary
*.jpg binary
*.jpeg binary
*.gif binary
*.tgz binary
*.zip binary
*.ico binary
